* {
    g-spacing: 10px;
    g-margin: 0;
    b-color: #282a36cc;          /* Dracula background */
    fg-color: #f8f8f2;           /* Dracula foreground */
    fgp-color: #6272a4FF;        /* Dracula active */
    b-radius: 10px;
    g-padding: 8px;
    hl-color: #bd93f9;           /* Dracula purple */
    highlight: bold italic underline #ff5555;  /* Dracula red */
    hlt-color: #44475acc;        /* Dracula current-line */
    alt-color: #343746cc;        /* Slightly lighter alt */
    wbg-color: #282a36;          /* Dracula background */
    // wbg-color: #282a36d0;
    w-border: 2px solid;
    w-border-color: #6272a4;     /* Dracula active */
    w-padding: 12px;
}


configuration {
    //font: "Maple Mono NF CN bold 18";
    font : "JetBrains Mono NL ExtraBold 12";
    modi: "drun";
    show-icons: true;
    sort: true;
    sorting-method:"fzf";
    display-drun: " ";
}

listview {
    columns: 1;
    lines: 7;
    fixed-height: true;
    fixed-columns: true;
    cycle: false;
    scrollbar: false;
    border: 0px solid;
}

window {
    transparency: "real";
    width: 750px;
    height: 500px;
    border-radius: @b-radius;
    background-color: @wbg-color;
    border: 4px solid;
    border-color: @w-border-color;
    padding: @w-padding;
}

prompt {
    text-color: @fg-color;
}

inputbar {
    children: ["prompt", "entry"];
    spacing: @g-spacing;
}

entry {
    placeholder: "Hey, Search Apps...";
    text-color: @fg-color;
    placeholder-color: @fgp-color;
}

mainbox {
    spacing: @g-spacing;
    margin: @g-margin;
    padding: @g-padding;
    children: ["inputbar", "listview", "message"];
}

element {
    spacing: @g-spacing;
    margin: @g-margin;
    padding: @g-padding;
    border: 0px solid;
    border-radius: @b-radius;
    border-color: @b-color;
    background-color: transparent;
    text-color: @fg-color;
}

element normal.normal {
	background-color: transparent;
	text-color: @fg-color;
}

element alternate.normal {
	//background-color: @alt-color;
    background-color: transparent;
	text-color: @fg-color;
}

element selected.active {
	background-color: @hl-color;
	text-color: @hlt-color;
}

element selected.normal {
	background-color: @hl-color;
	text-color: @hlt-color;
}

element-text, element-icon {
    background-color: inherit;
    text-color:       inherit;
}

element-text selected.normal {
    highlight: bold italic underline #ff5555;
    background-color: inherit;
    text-color:       inherit;
}


message {
    background-color: red;
    border: 0px solid;
}

textbox {
    highlight:  @highlight;
    text-color: @foreground;
}
